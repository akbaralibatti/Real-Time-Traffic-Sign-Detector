# Flask
SECRET_KEY=generate-a-long-random-secret-before-running-in-production
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
FLASK_DEBUG=0

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=traffic_sign_db

# Security & Sessions
SESSION_EXPIRE_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
TOTP_ISSUER=NITK TrafficVision
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Video Uploads
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=100

# Machine Learning Model Paths (Fallback to stub mode if not found)
YOLO_WEIGHTS=ml/weights/best.pt
YOLO_IMGSZ=640
YOLO_DEVICE=
CNN_WEIGHTS=ml/weights/cnn_best.pth

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
